Prefixes: {
	AttunedPrefix: {
		DisplayName: Attuned
		AttunedTooltip: +{0}% mana efficiency and refined spell flow
		ResonanceTooltip: Repeated Attuned casts or hits build up to {0} resonance; it fades after {1} seconds without casting
		EmpoweredTooltip: At full resonance, the next cast costs no mana and releases projectiles {0}% faster
	}

	AwakenedPrefix: {
		DisplayName: Awakened
		DormantDisplayName: Dormant
		DormantTooltip: Dormant: +{0}% use speed and +{1} critical strike chance
		BuildTooltip: Sweet-spot sword hits build toward awakening in about {0} seconds of consistent contact
		AwakenedTooltip: Awakened for {0} seconds: +{1}% damage, +{2}% size, and +{3}% use speed
		StrikeTooltip: Awakened sweet-spot hits deal bonus damage based on target max life
		LockoutTooltip: After awakening ends, enters recovery for {0} seconds
	}

	BreachingPrefix: {
		DisplayName: Breaching
		ArmorPenetrationTooltip: +{0} armor penetration
		BreachTooltip: Crushing hits can breach resistant targets and heavy defenses ({0}+ defense)
		SizeTooltip: Heavy swing weapons gain +{0}% size
	}

	SkirmishingPrefix: {
		DisplayName: Skirmishing
		SkirmishWindowTooltip: Hits open a skirmish window for {0} seconds
		MobilityTooltip: During the window, movement speed rises by {0}%
		FollowUpTooltip: Firing during the window empowers the next shot with +{0}% projectile speed and +{1}% crit damage
	}

	EchoingPrefix: {
		DisplayName: Fractured
		FractureTooltip: Spatial fractures can cascade at {0}% / {1}% / {2}% chance
		FractureDamageTooltip: Fracture copies deal {0}% / {1}% / {2}% damage with growing instability
	}

	SanguinePrefix: {
		DisplayName: Vampiric
		LifeStealTooltip: Steals {0}% of damage dealt as life on hit
		ManaSiphonTooltip: Magic hits also siphon up to {0} mana on hit
		CriticalFeedTooltip: Critical hits feed {0}% harder
		ThresholdTooltip: Weakened prey below {0}% / {1}% / {2}% life feed more
		FrenzyTooltip: Threshold hits can trigger a {0}-second Frenzy every 15 seconds; deeper prey thresholds grant stronger +{1}% max attack speed and +{2}/{3}/{4} crit against weakened foes
	}

	RadiantPrefix: {
		DisplayName: Radiant
		RadiantTooltip: Emits light and inflicts On Fire! for {0} seconds
	}

	StormforgedPrefix: {
		DisplayName: Stormforged
		StormforgedTooltip: "{0}% chance to chain lightning to up to {1} nearby enemies"
	}

	TemporalPrefix: {
		DisplayName: Temporal
		TemporalTooltip: +{0}% attack speed; projectile weapons also gain +{1}% projectile speed
		FractureTooltip: Repeated hits build {0} Time Fracture Pressure; fractured targets store Temporal damage for {1} seconds, then collapse for +{2}% after {3} seconds of cooldown
	}

	DesperatePrefix: {
		DisplayName: Desperate
		DesperateTooltip: Up to +{0}% damage as life falls
		ThresholdTooltip: Awakens below {0}% / {1}% / {2}% life
		SurgeTooltip: Critical life enables a surge hit every {0} seconds for +{1}% damage
	}

	CatalyticPrefix: {
		DisplayName: Catalytic
		CatalyticTooltip: Marks enemies for {0} seconds; next hit consumes the mark for +{1}% damage
	}

	DeadeyePrefix: {
		DisplayName: Deadeye
		ReadyTooltip: Deadeye readies every {0} seconds, or after {1} seconds of holding still
		ShotTooltip: The next shot gains +{0}% projectile speed, +{1} critical chance, and +{2}% critical damage
		BurstTooltip: Critical Deadeye Shots release a leafy burst for {0}% damage within {1} px
	}

	SpinboundPrefix: {
		DisplayName: Spinbound
		SpinboundTooltip: Valid Spinbound geometry empowers releases for +{0}% damage and +{1}% crit damage; Fibonacci cadence grants +1 Golden Spin tier
		GoldenSpinTooltip: Golden Spin geometry can amplify the Spinbound payoff up to {0}x
	}

	ShiftingPrefix: {
		DisplayName: Shifting
		ShiftingTooltip: Rewrites itself every {0} seconds while in combat; fades after {1} seconds out of combat
		ShiftPowerTooltip: Simulated modifiers are applied at {0}% strength
		CurrentTooltip: Currently shifting: {0} ({1}%)
		CombatText: Shifting: {0}
	}
}

Configs: {
	PrefixTuningConfig: {
		DisplayName: Prefix Tuning Config

		Headers: {
			Overview: Modifier Pages
