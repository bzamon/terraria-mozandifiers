		}

		Attuned: {
			Label: Attuned

			MaxResonanceStacks: {
				Label: Max Resonance Stacks
				Tooltip: Maximum resonance stacks Attuned can build before empowering the next cast.
			}

			ResonanceDecayTicks: {
				Label: Resonance Decay (Ticks)
				Tooltip: How long resonance lasts without casting or qualifying hits.
			}

			ResonanceHitGainCooldownTicks: {
				Label: Hit Gain Cooldown (Ticks)
				Tooltip: Minimum delay between resonance gains from hit-based Attuned triggers.
			}

			EmpoweredCastShootSpeedPercent: {
				Label: Empowered Cast Projectile Speed (%)
				Tooltip: Projectile speed bonus granted to the empowered cast at full resonance.
			}

			Tooltip: ""
		}

		Awakened: {
			Label: Awakened

